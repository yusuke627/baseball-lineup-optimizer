{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BatterPreset",
  "type": "object",
  "required": ["id", "name", "season", "league", "source", "stats"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "一意なID(例: shohei_ohtani_2025)" },
    "name": { "type": "string" },
    "team": { "type": "string", "description": "画面に出す球団の表記" },
    "team_info": {
      "type": "object",
      "description": "所属球団の情報。省略可。移籍した選手は、そのシーズンの最後に出場した球団。球団での絞り込みに使う。",
      "required": ["code", "name", "league"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$",
          "description": "球団コード (英大文字2〜3文字。例: NYY、SD)。プロジェクトで統一した表記で、Lahman の teamID と異なる球団がある (scripts/build_lahman_presets.py の TEAM_CODE_BY_LAHMAN_ID)"
        },
        "name": { "type": "string", "minLength": 1, "description": "球団名 (Lahman の Teams.csv の name のまま)" },
        "league": { "type": "string", "enum": ["AL", "NL"], "description": "所属リーグ (Lahman の lgID)" },
        "division": { "type": "string", "enum": ["E", "C", "W"], "description": "所属地区 (E: 東地区、C: 中地区、W: 西地区。Lahman の Teams.csv の divID)。省略可" },
        "lahman_id": { "type": "string", "minLength": 1, "description": "Lahman Baseball Database の teamID (元データとの対応を追うため。省略可)" }
      }
    },
    "teams_played": {
      "type": "array",
      "description": "そのシーズンに在籍した球団 (出場した順)。複数の球団に在籍した選手だけに書く。成績はこれらの球団での合計。最後の要素は team_info.code と同じ球団 (backend/tests/test_preset_schema.py で検査)。",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{2,3}$", "description": "team_info.code と同じ表記の球団コード" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "season": { "type": "integer" },
    "league": { "type": "string", "enum": ["MLB"] },
    "verified": {
      "type": "boolean",
      "description": "statsが公式ソースで裏取り済みの実データかどうか。falseの場合はプレースホルダー扱い。reference_metrics の確認状況はこの欄では表さない(reference_metrics の説明を参照)。"
    },
    "source": {
      "type": "object",
      "required": ["provider", "url", "retrieved_at"],
      "properties": {
        "provider": { "type": "string" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "画面でリンクにするため、https:// で始まるURLだけを許可する。"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "成績を取得した日(YYYY-MM-DD)"
        },
        "note": { "type": "string", "description": "出典についての補足 (生成の方法、照合の状況など)。省略可" }
      }
    },
    "stats": {
      "type": "object",
      "required": ["PA", "AB", "H", "2B", "3B", "HR", "BB", "HBP", "SO", "SF", "GIDP", "SB", "CS"],
      "properties": {
        "PA": { "type": "integer", "minimum": 1 },
        "AB": { "type": "integer", "minimum": 0 },
        "H": { "type": "integer", "minimum": 0 },
        "2B": { "type": "integer", "minimum": 0 },
        "3B": { "type": "integer", "minimum": 0 },
        "HR": { "type": "integer", "minimum": 0 },
        "BB": { "type": "integer", "minimum": 0 },
        "HBP": { "type": "integer", "minimum": 0 },
        "SO": { "type": "integer", "minimum": 0 },
        "SF": { "type": "integer", "minimum": 0 },
        "SH": { "type": "integer", "minimum": 0 },
        "GIDP": { "type": "integer", "minimum": 0 },
        "SB": { "type": "integer", "minimum": 0 },
        "CS": { "type": "integer", "minimum": 0 }
      }
    },
    "reference_metrics": {
      "type": "object",
      "description": "公表されている指標(wOBA・wRC+)の参考値。省略可。モデルの計算には使わず、画面に参考として表示するだけ。アプリはこれらの指標を計算しないので、出典で確認した公表値だけを書く(未確認の値や仮の値は書かない。書いてあること自体が、出典で確認済みという意味になる)。season はプリセットの season と同じ年にする。",
      "required": ["season", "source", "retrieved_at"],
      "anyOf": [{ "required": ["wOBA"] }, { "required": ["wRC_plus"] }],
      "additionalProperties": false,
      "properties": {
        "wOBA": { "type": "number", "minimum": 0 },
        "wRC_plus": { "type": "number", "description": "wRC+" },
        "season": { "type": "integer", "description": "値の対象シーズン" },
        "source": {
          "type": "object",
          "required": ["provider", "url"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1, "description": "出典名" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "description": "値を確認したページ。https:// で始まるURLだけを許可する。"
            }
          }
        },
        "retrieved_at": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "値を取得した日(YYYY-MM-DD)"
        },
        "note": { "type": "string", "description": "備考" }
      }
    }
  }
}
